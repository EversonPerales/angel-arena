# Puerto del servidor Express / Socket.IO
PORT=3000

# Entorno de ejecución (development | production)
NODE_ENV=production

# Variables para Docker Compose / Coolify / Dokploy (PostgreSQL interno)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password_segura
POSTGRES_DB=angel_arena
DB_SSL=false

# Conexión directa a PostgreSQL (si usas un servicio externo o contenedor independiente)
DATABASE_URL=postgresql://postgres:cambia_esta_password_segura@db:5432/angel_arena

# Clave secreta para firmar tokens JWT
JWT_SECRET=clave_secreta_super_segura_cambiar_en_produccion
